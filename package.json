{
  "name": "@nanostores/async",
  "version": "0.1.1",
  "description": "Async computed stores for Nano Stores",
  "keywords": [
    "nanostores",
    "stores",
    "state",
    "state manager",
    "async"
  ],
  "repository": "nanostores/async",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ai"
    }
  ],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "scripts": {
    "test": "pnpm run -s /^test:/",
    "test:coverage": "pnpm bnt --coverage",
    "test:lint": "prettier -c .",
    "test:size": "size-limit",
    "test:types": "check-dts"
  },
  "prettier": {
    "arrowParens": "avoid",
    "jsxSingleQuote": false,
    "quoteProps": "consistent",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@sinonjs/fake-timers": "^15.4.0",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "better-node-test": "^1.0.0",
    "check-dts": "^2.0.1",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "nanostores": "^1"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "authors": "Luiz Ferraz <luiz@lferraz.com>",
  "clean-publish": {
    "cleanDocs": true
  },
  "size-limit": [
    {
      "name": "Everything",
      "import": {
        "./index.js": "{ computedAsync, computedAsyncNoCascade }"
      },
      "limit": "388 B"
    }
  ]
}
